# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud Secrets.
# Never commit real credentials. This file contains placeholders only.
ASSIGNMENT_PASSWORD = "replace-with-your-assignment-password"
STORAGE_BACKEND = "dropbox"
DROPBOX_APP_KEY = "replace-with-app-key"
DROPBOX_APP_SECRET = "replace-with-app-secret"
DROPBOX_REFRESH_TOKEN = "replace-with-refresh-token"
DROPBOX_ROOT_PATH = "/choice_bias_assignment"
DROPBOX_CSV_NAME = "answers.csv"
DROPBOX_SUBJECT_CSV_NAME = "subjects.csv"

# Required for the AI exchange after each answer.
KEY_OPENAI = "replace-with-your-openai-api-key"
